{
  "realm": "transaction-platform",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "defaultSignatureAlgorithm": "RS256",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "order-api",
      "name": "Order API (resource server)",
      "description": "Owns the permissions of the public Order API. No one signs in with this client.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "scenario-runner",
      "name": "Scenario runner",
      "description": "Machine client used by the scenario runner and validation suites.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SCENARIO_RUNNER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "order-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "order-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "order-api-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "order-api",
            "claim.name": "permissions",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "order-reader",
      "name": "Order reader",
      "description": "Machine client that may only read orders; used to prove permission checks.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ORDER_READER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "order-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "order-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "order-api-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "order-api",
            "claim.name": "permissions",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "order-api": [
        { "name": "orders.read", "description": "Read orders" },
        { "name": "orders.write", "description": "Create orders" },
        { "name": "traces.debug", "description": "Request that a request's trace is always kept" }
      ]
    }
  },
  "users": [
    {
      "username": "service-account-scenario-runner",
      "enabled": true,
      "serviceAccountClientId": "scenario-runner",
      "clientRoles": { "order-api": ["orders.read", "orders.write", "traces.debug"] }
    },
    {
      "username": "service-account-order-reader",
      "enabled": true,
      "serviceAccountClientId": "order-reader",
      "clientRoles": { "order-api": ["orders.read"] }
    }
  ]
}
